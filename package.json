{
  "name": "corpus",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "description": "CORPUS — real-time human physiology simulator. NOT FOR CLINICAL USE.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tools tests --ext .ts,.tsx",
    "typecheck": "tsc -b --force",
    "organs": "vite-node tools/placeholder-organs.ts",
    "ingest": "vite-node tools/ingest/run.ts",
    "ingest:offline": "vite-node tools/ingest/run.ts -- --offline"
  },
  "dependencies": {
    "comlink": "^4.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.57.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
