{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@sim/*": ["src/sim/*"],
      "@data/*": ["src/data/*"]
    }
  },
  "include": ["vite.config.ts", "vitest.config.ts", "playwright.config.ts", "tools", "src/data/pharma-types.ts", "src/data/types.ts", "src/bridge/types.ts", "src/render/organs/placeholder.ts", "src/render/anatomy/models.ts", "src/render/anatomy/sdf.ts", "src/render/anatomy/noise.ts", "src/render/anatomy/layout.ts", "src/render/anatomy/shells/mouth.ts", "src/render/anatomy/shells/salivary_glands.ts", "src/render/anatomy/shells/pharynx.ts", "src/render/anatomy/shells/nasal_cavity.ts", "src/render/anatomy/shells/ears.ts", "src/render/anatomy/shells/skull.ts", "src/render/anatomy/shells/vertebral_column.ts", "src/render/anatomy/shells/thoracic_cage.ts", "src/render/anatomy/shells/upper_limb_bones.ts", "src/render/anatomy/shells/lower_limb_bones.ts"]
}
